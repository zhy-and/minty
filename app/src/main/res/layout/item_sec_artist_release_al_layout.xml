<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:id="@+id/container"
    android:orientation="vertical"
    android:paddingBottom="12dp"
    android:paddingHorizontal="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/ct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/thumbnail"
            android:layout_width="135dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_height="135dp"
            />
        <ImageView
            android:visibility="gone"
            android:background="@mipmap/item_play"
            android:id="@+id/play_icon"
            android:layout_width="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="@id/thumbnail"
            app:layout_constraintBottom_toBottomOf="@id/thumbnail"
            android:layout_height="wrap_content"
            />

        <ImageView
            android:visibility="gone"
            android:id="@+id/thumbnail2"
            android:layout_width="190dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_height="115dp"
            />

        <androidx.cardview.widget.CardView
            android:visibility="gone"
            android:id="@+id/thumbnail3"
            app:layout_constraintStart_toStartOf="parent"
            app:cardCornerRadius="38dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="75dp"
            android:layout_height="96dp">
            <ImageView
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:id="@+id/thumbnail_circle"
                app:layout_constraintBottom_toBottomOf="parent"
                android:scaleType="centerCrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                />
        </androidx.cardview.widget.CardView>
        <ImageView
            android:visibility="gone"
            android:background="@mipmap/video_play"
            android:id="@+id/play_icon2"
            android:layout_width="wrap_content"
            app:layout_constraintEnd_toEndOf="@id/thumbnail2"
            app:layout_constraintTop_toTopOf="@id/thumbnail2"
            app:layout_constraintStart_toStartOf="@id/thumbnail2"
            app:layout_constraintBottom_toBottomOf="@id/thumbnail2"
            android:layout_height="wrap_content"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <TextView
        app:layout_constraintTop_toBottomOf="@id/ct"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:layout_marginTop="4dp" />

    <TextView
        app:layout_constraintTop_toBottomOf="@id/title"
        android:lines="1"
        android:ellipsize="end"
        android:id="@+id/artist"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textColor="#829d77"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
