<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true"
    android:background="@mipmap/home_bg"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">
    <include
        android:id="@+id/tops"
        layout="@layout/include_search"
        />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@id/tops"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/ad_con"
        android:layout_height="wrap_content">

    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_marginTop="15dp"
        android:layout_marginBottom="18dp"
        app:layout_constraintTop_toBottomOf="@id/ad_con"
        android:id="@+id/flow_list"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginHorizontal="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:layout_marginHorizontal="18dp"
        app:layout_constraintTop_toBottomOf="@id/flow_list"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="10dp"
        android:text="Discover the ultimate music experience with our player! Enjoy the newest hits and timeless classics in one place. With a vast, constantly updated library, you’ll find all your favorite songs and artists. High-quality streaming, personalized playlists, and seamless playback let you immerse in music anytime, anywhere. Start exploring—your perfect soundtrack awaits!"
        android:textColor="#5C6C56"
        android:textSize="14sp"
        />





</androidx.constraintlayout.widget.ConstraintLayout>