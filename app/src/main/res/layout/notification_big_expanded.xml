<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="26dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <ImageView
        android:id="@+id/notif_big_logo"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:contentDescription="@null"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/notif_event_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/notif_event_title"
        android:textSize="16sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/notif_event_action_wrap"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="26dp"
        android:background="@drawable/bg_notif_cta_clip"
        android:clipToOutline="true"
        android:outlineProvider="background">

        <ImageView
            android:id="@+id/notif_event_action_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY" />

        <ProgressBar
            android:id="@+id/notif_event_action_pulse_blue"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/anim_notif_cta_scale_blue"
            android:indeterminateOnly="true"
            android:max="100"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/notif_event_action_pulse_green"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/anim_notif_cta_scale_green"
            android:indeterminateOnly="true"
            android:max="100"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/notif_event_action_pulse_red"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/anim_notif_cta_scale_red"
            android:indeterminateOnly="true"
            android:max="100"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/notif_event_action_pulse_yellow"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/anim_notif_cta_scale_yellow"
            android:indeterminateOnly="true"
            android:max="100"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/notif_event_action_pulse_black"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/anim_notif_cta_scale_black"
            android:indeterminateOnly="true"
            android:max="100"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/notif_event_action_pulse"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/anim_notif_cta_shimmer"
            android:indeterminateOnly="true"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/notif_event_action"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/notif_event_action_open_home"
            android:textColor="@color/notif_event_cta_on_light"
            android:textSize="15sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
