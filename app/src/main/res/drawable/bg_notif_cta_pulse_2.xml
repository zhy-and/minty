<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="3dp"
        android:left="8dp"
        android:right="8dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:endColor="#ff009980"
                android:startColor="#ff4fd4bc"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
