<?xml version="1.0" encoding="utf-8"?>
<!-- Slightly inset = looks smaller (scale down). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="2dp"
        android:left="4dp"
        android:right="4dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:endColor="#ff00c09c"
                android:startColor="#ff7aead4"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
