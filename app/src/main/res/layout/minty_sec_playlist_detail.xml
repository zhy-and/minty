<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/home_bg"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <include
        android:id="@+id/top_con"
        layout="@layout/top_containers"
        />
    <include
        android:id="@+id/bottom_player"
        layout="@layout/bottom_mp"
        />

    <androidx.core.widget.NestedScrollView
        app:layout_constraintTop_toBottomOf="@id/top_con"
        app:layout_constraintBottom_toTopOf="@id/bottom_player"
        android:layout_width="match_parent"
        android:layout_height="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                app:layout_constraintTop_toBottomOf="@id/container"
                app:layout_constraintStart_toStartOf="parent"
                android:id="@+id/ad_con"
                android:layout_height="wrap_content">

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_marginHorizontal="14dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/container"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                >
                <ImageView
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:id="@+id/thumbnailo"
                    android:layout_width="0dp"
                    android:layout_height="134dp"
                    app:layout_constraintDimensionRatio="1:1" />
                <ImageView
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:id="@+id/det_bg"
                    android:layout_width="0dp"
                    android:src="@mipmap/det_logo_bg"
                    android:layout_height="134dp"
                    app:layout_constraintDimensionRatio="1:1" />

                <TextView
                    android:layout_marginStart="12dp"
                    app:layout_constraintTop_toTopOf="@id/thumbnailo"
                    android:maxLines="2"
                    android:textColor="#ffffff"
                    android:ellipsize="end"
                    app:layout_constraintStart_toEndOf="@id/thumbnailo"
                    android:id="@+id/titles"
                    android:layout_width="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:includeFontPadding="false"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:layout_marginStart="12dp"
                    android:textColor="#ffffff"
                    android:lines="1"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:ellipsize="end"
                    app:layout_constraintTop_toBottomOf="@id/titles"
                    app:layout_constraintStart_toEndOf="@id/thumbnailo"
                    android:id="@+id/artists"
                    android:includeFontPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:layout_marginTop="8dp" />

                <ImageView
                    android:background="@mipmap/all_play"
                    android:layout_marginStart="12dp"
                    app:layout_constraintStart_toEndOf="@id/thumbnailo"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginBottom="10dp"
                    android:id="@+id/play_btns"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintDimensionRatio="H,1:1" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:layout_marginTop="7dp"
                android:layout_marginBottom="18dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                app:layout_constraintTop_toBottomOf="@id/ad_con"
                android:id="@+id/mood_and_genres_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_player"
        app:layout_constraintTop_toBottomOf="@id/top_con"
        android:layout_height="0dp">
        <io.supercharge.shimmerlayout.ShimmerLayout
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/spec_anm2"
            app:shimmer_animation_duration="1000"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include layout="@layout/include_loading"/>
        </io.supercharge.shimmerlayout.ShimmerLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
