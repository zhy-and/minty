<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >


        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing"
            android:background="@mipmap/title_bg"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:expandedTitleMarginEnd="64dp"
            app:expandedTitleMarginStart="48dp"

            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_marginBottom="7dp"
                android:id="@+id/backdrop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_collapseMode="parallax">

                <TextView
                    android:layout_marginTop="50dp"
                    android:id="@+id/a"
                    app:layout_constraintTop_toTopOf="parent"
                    android:background="@mipmap/mintymusic"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_marginTop="15dp"
                    android:elevation="5dp"
                    android:background="@drawable/home_sec_search_shape"
                    app:layout_constraintTop_toBottomOf="@id/a"
                    android:id="@+id/search_edit_text2"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    >    <TextView
                    android:layout_marginStart="12dp"
                    android:id="@+id/search"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:background="@mipmap/sec_search"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                    <TextView
                        android:layout_marginStart="8dp"
                        app:layout_constraintStart_toEndOf="@id/search"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Search for a song or artist"
                        android:textColor="#FFB0B0B0"
                        android:textSize="16sp"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/tools"
                android:layout_marginTop="35dp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#00000000"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/tops"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    app:layout_collapseMode="pin"
                    app:layout_constraintStart_toStartOf="parent">
                    <!---->
                    <ImageView
                        android:id="@+id/end_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@mipmap/about"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <!---->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:visibility="gone"
                        android:background="@drawable/home_sec_search_shape"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:id="@+id/search_edit_text"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="11dp"
                        android:layout_marginEnd="11dp"
                        app:layout_constraintEnd_toStartOf="@id/list_button"
                        app:layout_constraintStart_toEndOf="@id/end_btn"
                        >

                        <TextView
                            android:layout_marginStart="12dp"
                            android:id="@+id/search2"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:background="@mipmap/sec_search"
                            app:layout_constraintStart_toStartOf="parent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:layout_marginStart="8dp"
                            app:layout_constraintStart_toEndOf="@id/search2"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Search for a song or artist"
                            android:textColor="#B0B0B0"
                            android:textSize="16sp"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <ImageView

                        android:id="@+id/list_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="15dp"
                        android:src="@mipmap/list"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <!---->
                    <!---->
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.appcompat.widget.Toolbar>


        </com.google.android.material.appbar.CollapsingToolbarLayout>


    </com.google.android.material.appbar.AppBarLayout>





    <androidx.core.widget.NestedScrollView
        android:background="#1E1D18"
        android:id="@+id/scroll"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                app:layout_constraintTop_toBottomOf="@id/ad_con"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="33dp"
                android:id="@+id/topos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_marginEnd="7dp"
                    app:layout_constraintHorizontal_weight="1"
                    android:background="@mipmap/his"
                    android:id="@+id/history"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/fav"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintDimensionRatio="140:34"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>

                <TextView
                    android:layout_marginStart="7dp"
                    app:layout_constraintHorizontal_weight="1"
                    android:background="@mipmap/fav"
                    android:id="@+id/fav"
                    app:layout_constraintStart_toEndOf="@id/history"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintDimensionRatio="140:34"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:id="@+id/ad_con"
                android:layout_height="wrap_content">

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                app:layout_constraintTop_toBottomOf="@id/topos"
                app:layout_constraintStart_toStartOf="parent"
                android:id="@+id/home_page_sections_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />


            <androidx.recyclerview.widget.RecyclerView
                app:layout_constraintTop_toBottomOf="@id/new_release_title"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="9dp"
                android:id="@+id/new_release_albums_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:visibility="gone"
                android:id="@+id/new_release_title"
                android:padding="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/home_page_sections_recycler_view"
                android:layout_width="match_parent"

                android:layout_height="wrap_content">
                <TextView
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:textSize="18sp"
                    android:textColor="#ffffff"
                    android:textStyle="bold"
                    android:text="New release albums"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <ImageView
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:src="@mipmap/mo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:visibility="gone"
                android:id="@+id/mood_title"
                android:padding="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/new_release_albums_recycler_view"
                android:layout_width="match_parent"

                android:layout_height="wrap_content">
                <TextView
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:textSize="18sp"
                    android:textColor="#ffffff"
                    android:textStyle="bold"
                    android:text="Mood and Genres"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                app:layout_constraintTop_toBottomOf="@id/mood_title"
                app:layout_constraintStart_toStartOf="parent"
                android:id="@+id/mood_and_genres_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_marginHorizontal="12dp"
                android:id="@+id/line2"
                app:layout_constraintTop_toBottomOf="@id/mood_and_genres_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="80dp"/>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_marginTop="75dp"
                android:visibility="gone"
                android:id="@+id/empty_layout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/topos"
                app:layout_constraintEnd_toEndOf="parent"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:gravity="center"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/em_iv"
                    android:src="@mipmap/no_net"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/em_tx"
                    android:layout_marginHorizontal="27dp"
                    android:gravity="center"
                    android:layout_marginTop="30dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="There may be some network problems.
You can try clicking the button to refresh."
                    android:textColor="#829D77"
                    android:textSize="14sp"
                    />

                <ImageView
                    android:layout_marginTop="34dp"
                    android:id="@+id/emo_scan"
                    android:src="@mipmap/refre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </androidx.appcompat.widget.LinearLayoutCompat>

            <io.supercharge.shimmerlayout.ShimmerLayout
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/topos"
                app:layout_constraintBottom_toBottomOf="parent"
                android:id="@+id/spec_anm"
                android:layout_marginTop="15dp"
                app:shimmer_animation_duration="1000"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="match_parent"
                android:layout_height="0dp">
                <include layout="@layout/include_loading"/>
            </io.supercharge.shimmerlayout.ShimmerLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/bottom_player"
        layout="@layout/bottom_mp"
        />
</androidx.coordinatorlayout.widget.CoordinatorLayout>