<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_widget_card"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/widgetSongTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_empty_title"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Now playing" />

    <TextView
        android:id="@+id/widgetSongArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_empty_artist"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp"
        tools:text="Artist" />

    <FrameLayout
        android:id="@+id/widgetProgressArea"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginTop="12dp">

        <ProgressBar
            android:id="@+id/widgetProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="center_vertical"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/bg_music_widget_progress_layer" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widgetFavorite"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_favorites"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_favorites" />

        <ImageView
            android:id="@+id/widgetPrev"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_prev"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_prev" />

        <ImageView
            android:id="@+id/widgetPlayPause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_music_widget_play"
            android:contentDescription="@string/widget_play_pause"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_play" />

        <ImageView
            android:id="@+id/widgetNext"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_next"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_next" />

        <ImageView
            android:id="@+id/widgetQueue"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_queue"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_queue" />
    </LinearLayout>
</LinearLayout>
